# Copy this to `.env` and fill in your own values.
# `.env` is gitignored — NEVER commit real keys.

# ElevenLabs — the song voice (tools/tts/eleven.py).
# NB: needs a PAID plan; the free tier can't use library voices via the API.
# Key:      elevenlabs.io → your profile → API key.
eleven_labs=

# A voice to speak in: elevenlabs.io → Voices → pick one → copy its "Voice ID".
eleven_voice_id=
