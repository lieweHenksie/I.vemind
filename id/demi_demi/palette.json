{
  "_comment": "demi_demi's SOUND — a crate jam (no essay, no voice lines): the Demi Demi short split and dropped. D-minor bounce at 104, now spending the Switch Angel bank: acid-tamed saw (lpf+lpenv), energy = opening the filter (saw.range sweep into the drop), fake sidechain pump via gain patterns (real duck* needs a pin bump). Overrides cookbook/strudel/palette.json; riser falls back to the default.",
  "_samples": {
    "demicall": "audio/samples/demicall.wav",
    "toughline": "audio/samples/toughline.wav",
    "demistab": "audio/samples/demistab.wav",
    "toughtime": "audio/samples/toughtime.wav",
    "sermon": "audio/samples/sermon.wav"
  },
  "bed": "s(\"demicall\").slow(14).lpf(1100).gain(0.34).room(0.5)",
  "preach": "s(\"sermon\").slow(3).gain(1.05).room(0.2)",
  "toughcall": "s(\"toughtime\").slow(3).gain(1.15).room(0.35)",
  "dropcall": "s(\"toughline\").slow(4).gain(1.2).room(0.3)",
  "chopsparse": "s(\"toughline\").slice(8, \"0 ~ ~ 2 ~ 5 ~ ~\").lpf(3500).gain(0.9)",
  "chopdrop": "s(\"toughline\").slice(8, \"<[0 2 1 3 ~ 5 6 7] [7 ~ 6 4 [2 2] 1 0 ~]>\").shape(0.1).gain(1)",
  "stab": "s(\"~ ~ ~ demistab\").gain(1.1).room(0.3)",
  "acid": "note(\"[d3 f3 d3 a3 g3 d3 f3 c3]*2\").s(\"sawtooth\").lpf(saw.range(250,2600).slow(3)).lpenv(3).lpdecay(0.12).gain(0.34)",
  "acidpump": "note(\"[d3 f3 d3 a3 g3 d3 f3 c3]*2\").s(\"sawtooth\").lpf(2200).lpenv(3).lpdecay(0.12).gain(\"0.12 0.3 0.38 0.12 0.3 0.38 0.12 0.3\")",
  "tick": "s(\"white ~ ~ ~ white ~ ~ ~\").decay(0.02).sustain(0).hpf(7000).gain(0.1)",
  "bass": "note(\"d2 ~ ~ d2 ~ ~ f1 ~\").s(\"sawtooth\").lpf(480).lpq(6).gain(0.85)",
  "kick": "note(\"d1 ~ ~ d1 ~ ~ d1 ~\").s(\"sine\").attack(0.001).decay(0.35).sustain(0).shape(0.15).gain(1)",
  "clap": "s(\"~ white ~ white\").decay(0.18).sustain(0).hpf(1800).lpf(6500).shape(0.12).gain(0.5).room(0.4)",
  "hats": "s(\"white ~ white white ~ white white ~\").decay(0.03).sustain(0).hpf(6000).gain(0.16)"
}
